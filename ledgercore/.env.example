# ---- runtime ----
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
SHUTDOWN_TIMEOUT_MS=15000

# ---- database ----
# Phase 3 runs a single Postgres. pgBouncer arrives in Phase 11.
DATABASE_URL=postgresql://ledgercore:ledgercore@localhost:5432/ledgercore?schema=public&connection_limit=10&pool_timeout=10
DB_STATEMENT_TIMEOUT_MS=5000

# ---- auth (Phase 3 issues access tokens only; refresh rotation is Phase 4) ----
JWT_SECRET=dev-only-secret-change-me-at-least-32-chars-long
JWT_ISSUER=ledgercore
JWT_AUDIENCE=ledgercore-api
ACCESS_TOKEN_TTL_SECONDS=900

# ---- http ----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
BODY_LIMIT=256kb

# ---- Phase 4: refresh tokens ----
# Absolute session ceiling (7 days). Rotation never extends beyond this.
REFRESH_TOKEN_TTL_SECONDS=604800
REFRESH_COOKIE_NAME=lc_rt
# true only when served over HTTPS -- a Secure cookie is dropped over plain http.
COOKIE_SECURE=false

# ---- Phase 6: Redis (cache role) ----
REDIS_URL=redis://localhost:6379
# Kill switch: false makes every cache call a no-op and every lookup hit
# Postgres directly. Used to measure the cache, and to disable it in an incident.
CACHE_ENABLED=true
CACHE_DEFAULT_TTL_SECONDS=300
# Deliberately tight. A slow cache must never become a slow API -- past this,
# the call is abandoned and the database answers instead.
REDIS_COMMAND_TIMEOUT_MS=150
RATE_LIMIT_ENABLED=true

# ---- Phase 7: queue ----
# SEPARATE Redis from the cache: noeviction + AOF. A queue must not lose work;
# a cache must not block.
QUEUE_REDIS_URL=redis://localhost:6380
QUEUE_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=200
OUTBOX_BATCH_SIZE=50
WORKER_CONCURRENCY=5
