{
  "name": "ledgercore",
  "version": "0.3.0",
  "private": true,
  "description": "LedgerCore -- double-entry posting engine (Phase 3: backend foundation)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:all": "pnpm db:seed && pnpm db:seed:ledger && pnpm db:seed:aml",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "test:int": "vitest run --config vitest.int.config.ts",
    "docker:build": "docker build --target runtime -t ledgercore-api:local .",
    "docker:up": "docker compose --profile full up -d --build",
    "docker:down": "docker compose --profile full down",
    "docker:logs": "docker compose --profile full logs -f api",
    "docker:migrate": "docker compose --profile migrate run --rm migrate",
    "db:seed:ledger": "tsx prisma/seed-ledger.ts",
    "worker": "tsx watch src/worker.ts",
    "worker:start": "node dist/worker.js",
    "db:seed:aml": "tsx prisma/seed-aml.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bullmq": "^6.3.8",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.6.0",
    "prom-client": "^15.1.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.12",
    "pino-pretty": "^13.0.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
